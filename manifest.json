{
  "manifest_version": 3,
  "name": "YCLIENTS Audit Helper",
  "version": "1.5",
  "description": "Открывает чек-лист аудита для сделки AMO CRM с подстановкой данных филиала",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://yclients.amocrm.ru/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть чек-лист аудита",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}