{
  "manifest_version": 3,
  "name": "YCLIENTS Audit Helper",
  "version": "2.3",
  "description": "Чек-лист аудита для AMO CRM + скрипты продаж и быстрые ссылки",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://yclients.amocrm.ru/*",
    "https://yclients.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://yclients.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Открыть чек-лист аудита",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}